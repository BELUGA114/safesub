{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safesub",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sub/*"]
  },
  "secrets": {
    "required": ["TOKEN_KEY"]
  }
}
